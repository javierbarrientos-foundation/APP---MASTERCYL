---
---

<section id="contacto" class="seccion" hidden aria-labelledby="titulo-contacto">
  <div class="seccion__header">
    <span class="seccion__categoria">Atención y Soporte</span>
    <h2 id="titulo-contacto" class="seccion__titulo">Contacto y Asistencia</h2>
    <p class="seccion__subtitulo">Canales de atención al solicitante de la Fundación General de la Universidad de León y de la Empresa (FGULEM)</p>
  </div>

  <div class="bloque-contenido">
    <div class="contacto-grid">
      <!-- Tarjetas de información de contacto -->
      <div class="contacto-info">
        <h3 class="bloque-titulo" style="font-size: 1.15rem; margin-bottom: 1.25rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          Sede y Canales de Atención
        </h3>

        <div class="contacto-items">
          <div class="contacto-card">
            <div class="contacto-card__icono">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <div class="contacto-card__texto">
              <strong>Sede Oficial FGULEM</strong>
              <p>Edificio de Servicios Centrales, Campus de Vegazana s/n</p>
              <p>24071 León, España</p>
            </div>
          </div>

          <div class="contacto-card">
            <div class="contacto-card__icono">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div class="contacto-card__texto">
              <strong>Correo Electrónico de Consultas</strong>
              <p><a href="mailto:becas.mastercyl@fgulem.es">becas.mastercyl@fgulem.es</a></p>
              <p><a href="mailto:fundacion@fgulem.es">fundacion@fgulem.es</a></p>
            </div>
          </div>

          <div class="contacto-card">
            <div class="contacto-card__icono">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <div class="contacto-card__texto">
              <strong>Atención Telefónica</strong>
              <p><a href="tel:+34987291651">+34 987 29 16 51</a></p>
              <p style="font-size: 0.8rem; color: var(--color-text-light);">Lunes a viernes de 9:00 a 14:00 (hora de España)</p>
            </div>
          </div>

          <div class="contacto-card">
            <div class="contacto-card__icono">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            </div>
            <div class="contacto-card__texto">
              <strong>Registro Electrónico Oficial ULE</strong>
              <p>Presentación telemática del impreso firmado</p>
              <p><a href="https://sede.unileon.es" target="_blank" rel="noopener noreferrer">sede.unileon.es &rarr;</a></p>
            </div>
          </div>
        </div>

        <div class="aviso-caja aviso-caja--primary" style="margin-top: 1.25rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <div style="font-size: 0.875rem;">
            <strong>Aviso de Registro:</strong> Recuerda que FGULEM no recoge solicitudes en papel en sus oficinas. Todo el trámite oficial debe efectuarse por vía telemática.
          </div>
        </div>
      </div>

      <!-- Formulario de consulta directa -->
      <div class="contacto-form-caja">
        <h3 class="bloque-titulo" style="font-size: 1.15rem; margin-bottom: 1.25rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          Envíanos tu Consulta
        </h3>

        <form id="formulario-contacto" class="form-contacto">
          <div class="form-grupo">
            <label for="nombre-contacto" class="form-label">Nombre y apellidos *</label>
            <input type="text" id="nombre-contacto" class="form-input" placeholder="Tu nombre completo" required />
          </div>

          <div class="form-fila">
            <div class="form-grupo">
              <label for="email-contacto" class="form-label">Correo electrónico *</label>
              <input type="email" id="email-contacto" class="form-input" placeholder="tu.correo@ejemplo.com" required />
            </div>
            <div class="form-grupo">
              <label for="pais-contacto" class="form-label">País de residencia en Hispanoamérica *</label>
              <input type="text" id="pais-contacto" class="form-input" placeholder="Ej. Argentina, México, Colombia..." required />
            </div>
          </div>

          <div class="form-grupo">
            <label for="asunto-contacto" class="form-label">Motivo de la consulta *</label>
            <select id="asunto-contacto" class="form-input" required>
              <option value="">Selecciona una opción...</option>
              <option value="requisitos">Dudas sobre requisitos o vinculación con CyL</option>
              <option value="documentos">Acreditación documental y legalizaciones</option>
              <option value="plataforma">Incidencias con la plataforma de solicitud</option>
              <option value="masteres">Consulta sobre oferta de másteres en la ULE</option>
              <option value="registro">Presentación en el Registro Electrónico</option>
              <option value="otro">Otras consultas</option>
            </select>
          </div>

          <div class="form-grupo">
            <label for="mensaje-contacto" class="form-label">Mensaje o detalle de tu consulta *</label>
            <textarea id="mensaje-contacto" class="form-textarea" rows="4" placeholder="Escribe aquí tu consulta de forma detallada..." required></textarea>
          </div>

          <button type="submit" class="btn-primary" style="width: 100%;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            <span>Enviar consulta a FGULEM</span>
          </button>

          <p id="mensaje-exito" class="form-mensaje-exito" style="display: none;">
            ✓ ¡Gracias! Tu consulta ha sido enviada con éxito. Te responderemos en un plazo máximo de 24-48 horas laborables.
          </p>
          <p id="mensaje-error" class="form-mensaje-error" style="display: none;"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2rem;
  }

  .contacto-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contacto-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.15rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .contacto-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary-light);
  }

  .contacto-card__icono {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: rgba(138, 21, 40, 0.1);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contacto-card__texto strong {
    display: block;
    font-size: 0.95rem;
    color: var(--color-text-main);
    margin-bottom: 0.2rem;
  }

  .contacto-card__texto p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .contacto-form-caja {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .form-contacto {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .form-fila {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-grupo {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .form-input, .form-textarea {
    width: 100%;
    padding: 0.65rem 0.9rem;
    font-size: 0.9rem;
    font-family: var(--font-body);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text-main);
    transition: all var(--transition-fast);
  }

  .form-input:focus, .form-textarea:focus {
    outline: none;
    background: var(--color-surface);
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(138, 21, 40, 0.12);
  }

  .form-mensaje-exito {
    padding: 0.75rem 1rem;
    background: var(--color-success-bg);
    border: 1px solid var(--color-success-border);
    color: var(--color-success);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
    margin-top: 0.5rem;
  }

  .form-mensaje-error {
    padding: 0.75rem 1rem;
    background: #FEE2E2;
    border: 1px solid #FCA5A5;
    color: #991B1B;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
    margin-top: 0.5rem;
  }

  @media (max-width: 860px) {
    .contacto-grid {
      grid-template-columns: 1fr;
    }
    .form-fila {
      grid-template-columns: 1fr;
    }
  }
</style>
