---
---

<section id="contacto" class="seccion" hidden aria-labelledby="titulo-contacto">
  <div class="seccion__header">
    <span class="seccion__categoria">Atención y Soporte Oficial</span>
    <h2 id="titulo-contacto" class="seccion__titulo">Contacto y Asistencia</h2>
    <p class="seccion__subtitulo">Canales oficiales de atención e información de la Fundación General de la Universidad de Salamanca (FGUSAL)</p>
  </div>

  <div class="bloque-contenido">
    <div class="contacto-grid">
      <!-- Columna 1: Tarjetas de información institucional -->
      <div class="contacto-info">
        <h3 class="contacto-col-titulo">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <span>Sede y Canales de Atención</span>
        </h3>

        <div class="contacto-items">
          <!-- Sede Fonseca -->
          <div class="contacto-card">
            <div class="contacto-card__icono">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <div class="contacto-card__texto">
              <div class="contacto-card__header">
                <strong>Sede Central FGUSAL</strong>
                <span class="badge-sede">Salamanca</span>
              </div>
              <p>Hospedería del Colegio Fonseca, C/ Fonseca, 2</p>
              <p class="contacto-destacado">37002 Salamanca (España)</p>
            </div>
          </div>

          <!-- Correos Electrónicos -->
          <div class="contacto-card">
            <div class="contacto-card__icono">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div class="contacto-card__texto">
              <div class="contacto-card__header">
                <strong>Correos Electrónicos</strong>
                <span class="badge-canal">Consultas</span>
              </div>
              <p><a href="mailto:becas.mastercyl@usal.es" class="link-contacto">becas.mastercyl@usal.es</a></p>
              <p><a href="mailto:fundacion@usal.es" class="link-contacto">fundacion@usal.es</a></p>
            </div>
          </div>

          <!-- Teléfono -->
          <div class="contacto-card">
            <div class="contacto-card__icono">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <div class="contacto-card__texto">
              <div class="contacto-card__header">
                <strong>Atención Telefónica</strong>
                <span class="badge-canal">L-V 9:00 - 14:00</span>
              </div>
              <p><a href="tel:+34923294840" class="link-telefono">+34 923 29 48 40</a> (Secretaría)</p>
              <p class="contacto-nota">Horario peninsular de España</p>
            </div>
          </div>
        </div>

        <div class="aviso-caja aviso-caja--primary" style="margin-top: 1.5rem;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <div style="font-size: 0.875rem;">
            <strong>Aviso de Registro Telemático:</strong> Recuerda que FGUSAL no recoge solicitudes en formato papel en sus oficinas. Todo el trámite oficial debe efectuarse por vía telemática.
          </div>
        </div>
      </div>

      <!-- Columna 2: Formulario de consulta con diseño completo -->
      <div class="contacto-form-caja form-box">
        <div class="form-caja-header">
          <div class="form-header-icono">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          </div>
          <div>
            <h3 class="form-caja-titulo">Envíanos tu Consulta</h3>
            <p class="form-caja-subtitulo">El equipo técnico de FGUSAL te responderá en 24-48 horas laborables</p>
          </div>
        </div>

        <form id="formulario-contacto" class="form-contacto">
          <!-- Nombre -->
          <div class="form-grupo">
            <label for="nombre-contacto" class="form-label">
              <span>Nombre y apellidos</span>
              <span class="req">* Obligatorio</span>
            </label>
            <div class="form-input-wrap">
              <svg class="form-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              <input type="text" id="nombre-contacto" class="form-input" placeholder="Tu nombre completo" required autocomplete="name" />
            </div>
          </div>

          <!-- Email y País en 2 columnas -->
          <div class="form-fila">
            <div class="form-grupo">
              <label for="email-contacto" class="form-label">
                <span>Correo electrónico</span>
                <span class="req">* Obligatorio</span>
              </label>
              <div class="form-input-wrap">
                <svg class="form-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                <input type="email" id="email-contacto" class="form-input" placeholder="tu.correo@ejemplo.com" required autocomplete="email" />
              </div>
            </div>

            <div class="form-grupo">
              <label for="pais-contacto" class="form-label">
                <span>País de residencia</span>
                <span class="req">* Hispanoamérica</span>
              </label>
              <div class="form-input-wrap">
                <svg class="form-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                <input type="text" id="pais-contacto" class="form-input" placeholder="Ej. Argentina, México, Colombia..." required />
              </div>
            </div>
          </div>

          <!-- Motivo de Consulta -->
          <div class="form-grupo">
            <label for="asunto-contacto" class="form-label">
              <span>Motivo o área de tu consulta</span>
              <span class="req">* Selecciona tema</span>
            </label>
            <div class="form-input-wrap">
              <svg class="form-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
              <select id="asunto-contacto" class="form-select" required>
                <option value="">Selecciona el tema de tu consulta...</option>
                <option value="requisitos">Dudas sobre requisitos de origen / vinculación con CyL</option>
                <option value="documentos">Acreditación documental, títulos y equivalencias</option>
                <option value="plataforma">Incidencias técnicas con la plataforma telemática</option>
                <option value="masteres">Consulta sobre másteres oficiales ofertados en la USAL</option>
                <option value="registro">Procedimiento de entrega en la Sede Electrónica USAL</option>
                <option value="otro">Otras consultas y trámites</option>
              </select>
            </div>
          </div>

          <!-- Mensaje -->
          <div class="form-grupo">
            <label for="mensaje-contacto" class="form-label">
              <span>Mensaje detallado</span>
              <span class="req">* Obligatorio</span>
            </label>
            <textarea id="mensaje-contacto" class="form-textarea" rows="4" placeholder="Explica tu duda o situación detallando tu caso..." required></textarea>
            <span class="form-helper">Indica tus datos para una respuesta personalizada</span>
          </div>

          <!-- Botón de Envío -->
          <button type="submit" class="form-btn-submit" style="margin-top: 0.5rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            <span>Enviar consulta a FGUSAL</span>
          </button>

          <!-- Mensajes de Estado -->
          <p id="mensaje-exito" class="form-mensaje-exito" style="display: none;">
            ✓ ¡Gracias! Tu consulta ha sido enviada con éxito. Te responderemos en un plazo máximo de 24-48 horas laborables.
          </p>
          <p id="mensaje-error" class="form-mensaje-error" style="display: none;"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 2.5rem;
    align-items: start;
  }

  .contacto-col-titulo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 1.5rem;
  }

  .contacto-col-titulo svg {
    color: var(--color-primary);
  }

  .contacto-items {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .contacto-card {
    display: flex;
    align-items: flex-start;
    gap: 1.15rem;
    padding: 1.35rem;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .contacto-card:hover {
    transform: translateY(-2px);
    border-color: rgba(138, 21, 40, 0.35);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .contacto-card--destacada {
    background: linear-gradient(145deg, #FFFFFF 0%, #FFFDF8 100%);
    border-color: rgba(212, 175, 55, 0.4);
  }

  .contacto-card__icono {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: rgba(138, 21, 40, 0.08);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contacto-card__icono--gold {
    background: rgba(212, 175, 55, 0.15);
    color: #B45309;
  }

  .contacto-card__texto {
    flex: 1;
  }

  .contacto-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .contacto-card__header strong {
    font-size: 0.98rem;
    color: #0F172A;
    font-weight: 700;
  }

  .badge-sede, .badge-canal, .badge-online {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
  }

  .badge-sede {
    background: rgba(138, 21, 40, 0.08);
    color: var(--color-primary);
  }

  .badge-canal {
    background: #F1F5F9;
    color: #475569;
  }

  .badge-online {
    background: #ECFDF5;
    color: #059669;
    border: 1px solid #A7F3D0;
  }

  .contacto-card__texto p {
    font-size: 0.885rem;
    color: #64748B;
    line-height: 1.5;
    margin: 0.15rem 0;
  }

  .contacto-destacado {
    font-weight: 600;
    color: #334155 !important;
  }

  .contacto-nota {
    font-size: 0.8rem !important;
    color: #94A3B8 !important;
  }

  .link-contacto {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .link-contacto:hover {
    color: var(--color-primary-dark);
  }

  .link-telefono {
    color: #0F172A;
    font-weight: 700;
  }

  .link-sede {
    color: #B45309;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .link-sede:hover {
    color: #92400E;
    text-decoration: underline;
  }

  /* Formulario a la derecha */
  .form-caja-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #E2E8F0;
  }

  .form-header-icono {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(138, 21, 40, 0.12) 0%, rgba(212, 175, 55, 0.15) 100%);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .form-caja-titulo {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0F172A;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .form-caja-subtitulo {
    font-size: 0.865rem;
    color: #64748B;
    margin: 0.25rem 0 0 0;
  }

  .form-contacto {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-mensaje-exito {
    padding: 1.15rem 1.25rem;
    background: #F0FDF4;
    border: 1.5px solid #86EFAC;
    color: #14532D;
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
    margin-top: 0.75rem;
    box-shadow: 0 4px 12px rgba(22, 163, 74, 0.1);
  }

  .form-mensaje-error {
    padding: 1.15rem 1.25rem;
    background: #FEF2F2;
    border: 1.5px solid #FCA5A5;
    color: #991B1B;
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
    margin-top: 0.75rem;
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.1);
  }

  @media (max-width: 900px) {
    .contacto-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
