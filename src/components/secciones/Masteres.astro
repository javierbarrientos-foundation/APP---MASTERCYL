---

<section id="masteres" class="seccion" hidden aria-labelledby="titulo-masteres">
  <div class="seccion__header">
    <span class="seccion__categoria">Oferta Académica Oficial</span>
    <h2 id="titulo-masteres" class="seccion__titulo">Másteres Universitarios Oficiales</h2>
    <p class="seccion__subtitulo">Catálogo oficial de enseñanzas de postgrado presenciales de la Universidad de León computables para las Becas MásterCyL 2026-2027</p>
  </div>

  <div class="bloque-contenido">
    <div class="aviso-caja aviso-caja--primary">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
      <div>
        <strong>Requisito Académico Esencial:</strong> Conforme a las bases, el máster debe impartirse en <strong>régimen presencial</strong> y contar con un mínimo de <strong>60 créditos ECTS</strong> en la Universidad de León durante el curso 2026-2027.
      </div>
    </div>

    <!-- Controles del buscador de másteres -->
    <div class="masteres-controles">
      <div class="buscador-caja">
        <svg class="buscador-icono" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input 
          type="search" 
          id="buscador-masteres" 
          class="buscador-input" 
          placeholder="Buscar máster por título, área, centro o palabra clave (ej. Informática, MBA, Salud)..." 
          aria-label="Buscar máster universitario"
        />
        <button type="button" id="btn-limpiar-busqueda" class="btn-limpiar" aria-label="Limpiar búsqueda" style="display: none;">✕</button>
      </div>

      <div class="filtro-areas" role="group" aria-label="Filtrar por área de conocimiento">
        {areas.map((a, idx) => (
          <button 
            type="button" 
            class={`btn-filtro ${idx === 0 ? 'activo' : ''}`} 
            data-area={a.code}
          >
            {a.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Contador de resultados -->
    <div class="masteres-meta">
      <span id="contador-masteres" class="contador-texto">Mostrando {masteres.length} másteres oficiales</span>
    </div>

    <!-- Lista de tarjetas de másteres -->
    <div class="lista-masteres" id="contenedor-masteres">
      {masteres.map((m) => (
        <article 
          class="master-card" 
          data-area={m.areaCode} 
          data-titulo={m.titulo.toLowerCase()} 
          data-desc={m.descripcion.toLowerCase()}
          data-centro={m.centro.toLowerCase()}
          id={m.id}
        >
          <div class="master-card__top">
            <span class={`badge-area badge-area--${m.areaCode}`}>{m.area}</span>
            <div class="master-card__tags">
              <span class="tag-creditos">{m.creditos} ECTS</span>
              <span class="tag-modalidad">{m.modalidad}</span>
            </div>
          </div>

          <h3 class="master-card__titulo">{m.titulo}</h3>
          
          <div class="master-card__centro">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"></path><path d="M5 21V7l8-4v18"></path><path d="M19 21V11l-6-3"></path><path d="M9 9h1"></path><path d="M9 13h1"></path><path d="M9 17h1"></path></svg>
            <span>{m.centro}</span>
          </div>

          <p class="master-card__desc">{m.descripcion}</p>

          <div class="master-card__footer">
            <span class="valido-beca">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Válido para Beca MásterCyL
            </span>
            <a href="https://www.unileon.es/estudiantes/estudiantes-master" target="_blank" rel="noopener noreferrer" class="link-detalle" title="Ver plan de estudios en web de la Universidad de León">
              <span>Más información</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Mensaje sin resultados -->
    <div id="sin-resultados" class="sin-resultados-caja" style="display: none;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
      <h3>No se encontraron másteres coincidentes</h3>
      <p>Prueba con otros términos de búsqueda o selecciona "Todas las áreas" para ver la oferta completa.</p>
      <button type="button" id="btn-resetear-filtros" class="btn-primary" style="margin-top: 1rem; padding: 0.5rem 1.25rem; font-size: 0.9rem;">
        Restablecer filtros
      </button>
    </div>
  </div>
</section>

<style>
  .masteres-controles {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .buscador-caja {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .buscador-icono {
    position: absolute;
    left: 1.25rem;
    color: var(--color-text-light);
    pointer-events: none;
  }

  .buscador-input {
    width: 100%;
    padding: 1rem 3rem 1rem 3.25rem;
    font-size: 1rem;
    font-family: var(--font-body);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text-main);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .buscador-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 4px rgba(138, 21, 40, 0.12);
  }

  .btn-limpiar {
    position: absolute;
    right: 1.25rem;
    background: var(--color-surface-hover);
    border: none;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .filtro-areas {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-filtro {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-filtro:hover {
    background: var(--color-surface-alt);
    color: var(--color-text-main);
    border-color: var(--color-text-light);
  }

  .btn-filtro.activo {
    background: var(--color-primary);
    color: var(--color-text-white);
    border-color: var(--color-primary);
    box-shadow: 0 2px 6px rgba(138, 21, 40, 0.25);
  }

  .masteres-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .contador-texto {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .lista-masteres {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.25rem;
  }

  .master-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
