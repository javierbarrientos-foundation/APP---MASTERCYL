---
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import Menu from '../components/Menu.astro';
import Resumen from '../components/secciones/Resumen.astro';
import Bases from '../components/secciones/Bases.astro';
import Calendario from '../components/secciones/Calendario.astro';
import Masteres from '../components/secciones/Masteres.astro';
import Preguntas from '../components/secciones/Preguntas.astro';
import Contacto from '../components/secciones/Contacto.astro';
import FormularioInscripcion from '../components/FormularioInscripcion.astro';
---

<Layout 
  title="Becas MásterCyL 2026-2027 · Fundación General Universidad de Salamanca | FGUSAL"
  description="Convocatoria de 2 becas de 8.800 € para cursar estudios oficiales de máster presenciales en la Universidad de Salamanca dirigidas a oriundos de Castilla y León residentes en Hispanoamérica."
>
  <main id="contenido" class="contenido">
    <article class="convocatoria">
      <!-- Banner superior de la convocatoria -->
      <Banner />

      <!-- Menú de navegación por pestañas -->
      <Menu />

      <!-- Contenedor dinámico de secciones -->
      <div class="secciones">
        <Resumen />
        <Bases />
        <Calendario />
        <Masteres />
        <Preguntas />
        <Contacto />
      </div>
    </article>
  </main>

  <!-- Modal interactivo de Inscripción Oficial y Subida a R2 -->
  <FormularioInscripcion />

  <!-- Lógica JavaScript Vanilla: Gestión de Pestañas, Buscador y Conexión con Backend (API/DB) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      /* ========================================================
         1. NAVEGACIÓN POR PESTAÑAS (TABS)
         ======================================================== */
      const menuLinks = document.querySelectorAll('.menu-secciones a');
      const secciones = document.querySelectorAll('.secciones .seccion');

      function activarSeccion(targetId, updateUrl = true) {
        if (!targetId) return;
        const idLimpio = targetId.replace('#', '');
        const targetSection = document.getElementById(idLimpio);

        if (!targetSection) return;

        // Quitar aria-current del enlace anterior y asignarlo al nuevo
        menuLinks.forEach((link) => {
          const href = link.getAttribute('href');
          if (href === `#${idLimpio}`) {
            link.setAttribute('aria-current', 'true');
          } else {
            link.removeAttribute('aria-current');
          }
        });

        // Ocultar todas las secciones y mostrar únicamente la seleccionada
        secciones.forEach((sec) => {
          sec.setAttribute('hidden', '');
        });
        targetSection.removeAttribute('hidden');

        // Actualizar URL hash si se solicita
        if (updateUrl && window.location.hash !== `#${idLimpio}`) {
          history.pushState(null, '', `#${idLimpio}`);
        }
      }

      // Manejar clics en los enlaces del menú de pestañas
      menuLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const targetHref = link.getAttribute('href');
          activarSeccion(targetHref, true);

          // Scroll suave hacia la sección si está fuera de pantalla
          const navElement = document.querySelector('.menu-secciones');
          if (navElement) {
            const rect = navElement.getBoundingClientRect();
            if (rect.top < 0 || rect.top > 150) {
              navElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        });
      });

      // Manejar enlaces internos en la página (footer, avisos, etc.)
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        if (!anchor.closest('.menu-secciones') && anchor.id !== 'btn-preinscripcion') {
          anchor.addEventListener('click', (e) => {
            const href = anchor.getAttribute('href');
            if (href && href !== '#' && document.querySelector(`.secciones ${href}`)) {
              e.preventDefault();
              activarSeccion(href, true);
              const target = document.querySelector(href);
              if (target) {
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }
          });
        }
      });

      // Leer el hash de la URL al cargar la página
      if (window.location.hash) {
        activarSeccion(window.location.hash, false);
      }

      // Reaccionar a cambios en el historial (botón atrás/adelante)
      window.addEventListener('hashchange', () => {
        if (window.location.hash) {
          activarSeccion(window.location.hash, false);
        }
      });

      /* ========================================================
         2. BUSCADOR Y FILTROS DE MÁSTERES EN TIEMPO REAL
         ======================================================== */
      const buscadorInput = document.getElementById('buscador-masteres');
      const btnLimpiar = document.getElementById('btn-limpiar-busqueda');
      const botonesFiltro = document.querySelectorAll('.btn-filtro');
      const masterCards = document.querySelectorAll('.master-card');
      const contador = document.getElementById('contador-masteres');
      const sinResultados = document.getElementById('sin-resultados');
      const btnResetear = document.getElementById('btn-resetear-filtros');

      let areaActiva = 'todas';
      let terminoBusqueda = '';

      function normalizar(texto) {
        return (texto || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .trim();
      }

      function filtrarMasteres() {
        const query = normalizar(terminoBusqueda);
        let visibles = 0;

        masterCards.forEach((card) => {
          const cardArea = card.getAttribute('data-area');
          const cardTitulo = normalizar(card.getAttribute('data-titulo'));
          const cardDesc = normalizar(card.getAttribute('data-desc'));
          const cardCentro = normalizar(card.getAttribute('data-centro'));

          const coincideArea = (areaActiva === 'todas' || cardArea === areaActiva);
          const coincideBusqueda = !query || 
            cardTitulo.includes(query) || 
            cardDesc.includes(query) || 
            cardCentro.includes(query);

          if (coincideArea && coincideBusqueda) {
            card.style.display = 'flex';
            visibles++;
          } else {
            card.style.display = 'none';
          }
        });

        if (contador) {
          contador.textContent = `Mostrando ${visibles} ${visibles === 1 ? 'máster oficial' : 'másteres oficiales'}`;
        }

        if (sinResultados) {
          sinResultados.style.display = visibles === 0 ? 'flex' : 'none';
        }

        if (btnLimpiar) {
          btnLimpiar.style.display = terminoBusqueda.length > 0 ? 'flex' : 'none';
        }
      }

      if (buscadorInput) {
        buscadorInput.addEventListener('input', (e) => {
          terminoBusqueda = e.target.value;
          filtrarMasteres();
        });
      }

      if (btnLimpiar) {
        btnLimpiar.addEventListener('click', () => {
          if (buscadorInput) {
            buscadorInput.value = '';
            terminoBusqueda = '';
            buscadorInput.focus();
            filtrarMasteres();
          }
        });
      }

      botonesFiltro.forEach((btn) => {
        btn.addEventListener('click', () => {
          botonesFiltro.forEach((b) => b.classList.remove('activo'));
          btn.classList.add('activo');
          areaActiva = btn.getAttribute('data-area') || 'todas';
          filtrarMasteres();
        });
      });

      if (btnResetear) {
        btnResetear.addEventListener('click', () => {
          if (buscadorInput) buscadorInput.value = '';
          terminoBusqueda = '';
          areaActiva = 'todas';
          botonesFiltro.forEach((b) => {
            if (b.getAttribute('data-area') === 'todas') b.classList.add('activo');
            else b.classList.remove('activo');
          });
          filtrarMasteres();
        });
      }

      /* ========================================================
         3. MODAL DE INSCRIPCIÓN OFICIAL
         ======================================================== */
      const modalInscripcion = document.getElementById('modal-inscripcion') || document.getElementById('modal-preinscripcion');
      const btnsAbrirInscripcion = document.querySelectorAll('#btn-inscripcion, #btn-preinscripcion, [data-abrir-inscripcion]');
      const btnCerrarModalInscripcion = document.getElementById('btn-cerrar-modal-inscripcion') || document.getElementById('btn-cerrar-modal');

      function abrirModalInscripcion() {
        if (!modalInscripcion) return;
        modalInscripcion.showModal();
      }

      btnsAbrirInscripcion.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          abrirModalInscripcion();
        });
      });

      btnCerrarModalInscripcion?.addEventListener('click', () => {
        modalInscripcion?.close();
      });

      modalInscripcion?.addEventListener('click', (e) => {
        const rect = modalInscripcion.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          modalInscripcion.close();
        }
      });

      /* ========================================================
         4. ENVÍO DEL FORMULARIO OFICIAL DE INSCRIPCIÓN (API / D1 / R2)
         ======================================================== */
      const formInscripcion = document.getElementById('form-inscripcion-oficial') || document.getElementById('form-preinscripcion');
      const resultadoInscripcion = document.getElementById('resultado-inscripcion') || document.getElementById('resultado-preinscripcion');
      const btnSubmitInscripcion = document.getElementById('btn-submit-inscripcion') || document.getElementById('btn-submit-preinscripcion');

      if (formInscripcion) {
        formInscripcion.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!btnSubmitInscripcion) return;

          const checkPrivacidad = document.getElementById('insc-check-privacidad');
          if (checkPrivacidad && !checkPrivacidad.checked) {
            alert('Debes aceptar la política de privacidad y el tratamiento de datos para poder inscribirte.');
            return;
          }

          const formData = new FormData(formInscripcion);

          btnSubmitInscripcion.disabled = true;
          btnSubmitInscripcion.style.opacity = '0.7';
          btnSubmitInscripcion.innerHTML = `
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation: spin 1s linear infinite;"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle><path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path></svg>
            <span>Subiendo documentación a Cloudflare R2 y registrando inscripción...</span>
          `;
          if (resultadoInscripcion) resultadoInscripcion.style.display = 'none';

          try {
            const resp = await fetch('/api/inscripcion', {
              method: 'POST',
              body: formData
            });

            const data = await resp.json();

            if (resultadoInscripcion) {
              resultadoInscripcion.style.display = 'block';
              if (data.success) {
                resultadoInscripcion.className = 'resultado-caja resultado-caja--exito';
                resultadoInscripcion.innerHTML = `
                  <div style="font-size: 1.15rem; font-weight: 800; color: #166534; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    <span>¡Inscripción Oficial Registrada con Éxito!</span>
                  </div>
                  <div style="padding: 1.25rem; background: #ffffff; border-radius: 8px; border: 1.5px solid #86EFAC; margin-top: 0.75rem;">
                    <div><strong>Identificador de Solicitud:</strong> <span style="font-family: monospace; font-size: 1.15rem; color: #9E1B32; font-weight: 800;">#${data.id || 'REG-' + Date.now()}</span></div>
                    <div style="margin-top: 0.5rem; color: #334155;"><strong>Documentación:</strong> Tu documentación se ha recibido correctamente.</div>
                    <div style="margin-top: 0.35rem; color: #334155;"><strong>Notificación:</strong> Se ha remitido el expediente con los enlaces de descarga al correo de administración.</div>
                    <div style="font-size: 0.85rem; color: #64748b; margin-top: 0.75rem; line-height: 1.45;">
                      Guarda este comprobante. Nos pondremos en contacto contigo a través del correo electrónico facilitado durante el periodo de baremación.
                    </div>
                  </div>
                `;
                formInscripcion.reset();
              } else {
                resultadoInscripcion.className = 'resultado-caja resultado-caja--error';
                resultadoInscripcion.innerHTML = `<strong>✕ Error:</strong> ${data.error || 'No se pudo formalizar la inscripción.'}`;
              }
            }
          } catch (err) {
            if (resultadoInscripcion) {
              resultadoInscripcion.style.display = 'block';
              resultadoInscripcion.className = 'resultado-caja resultado-caja--error';
              resultadoInscripcion.innerHTML = '<strong>✕ Error de conexión:</strong> No se pudo conectar con el servidor. Por favor, comprueba el tamaño de tus archivos e inténtalo de nuevo.';
            }
          } finally {
            btnSubmitInscripcion.disabled = false;
            btnSubmitInscripcion.style.opacity = '1';
            btnSubmitInscripcion.innerHTML = `
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
              <span>Enviar Inscripción Oficial</span>
            `;
          }
        });
      }

      /* ========================================================
         5. ENVÍO DEL FORMULARIO DE CONTACTO (API / DB)
         ======================================================== */
      const formContacto = document.getElementById('formulario-contacto');
      const mensajeExito = document.getElementById('mensaje-exito');
      const mensajeError = document.getElementById('mensaje-error');

      if (formContacto) {
        formContacto.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = formContacto.querySelector('button[type="submit"]');

          const turnstileInput = formContacto.querySelector('[name="cf-turnstile-response"]');
          const turnstileToken = turnstileInput ? (turnstileInput as HTMLInputElement).value : '';

          const payload = {
            nombre: (document.getElementById('nombre-contacto') as HTMLInputElement)?.value,
            email: (document.getElementById('email-contacto') as HTMLInputElement)?.value,
            pais: (document.getElementById('pais-contacto') as HTMLInputElement)?.value,
            asunto: (document.getElementById('asunto-contacto') as HTMLInputElement)?.value,
            mensaje: (document.getElementById('mensaje-contacto') as HTMLTextAreaElement)?.value,
            'cf-turnstile-response': turnstileToken,
          };

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.7';
            submitBtn.innerHTML = '<span>Enviando al servidor...</span>';
          }
          if (mensajeExito) mensajeExito.style.display = 'none';
          if (mensajeError) mensajeError.style.display = 'none';

          try {
            const resp = await fetch('/api/contacto', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            const data = await resp.json();

            if (data.success) {
              if (mensajeExito) {
                mensajeExito.style.display = 'block';
                mensajeExito.textContent = `✓ ¡Gracias! Tu consulta (ID #${data.id}) ha sido guardada en la base de datos de FGUSAL. Te responderemos en un plazo máximo de 24-48 horas.`;
              }
              formContacto.reset();
            } else {
              if (mensajeError) {
                mensajeError.style.display = 'block';
                mensajeError.textContent = `✕ Error: ${data.error || 'No se pudo enviar la consulta.'}`;
              }
            }
          } catch (err) {
            if (mensajeError) {
              mensajeError.style.display = 'block';
              mensajeError.textContent = '✕ Error de conexión con el servidor.';
            }
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.style.opacity = '1';
              submitBtn.innerHTML = `
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                <span>Enviar consulta a FGUSAL</span>
              `;
            }
          }
        });
      }
    });
  </script>
</Layout>
