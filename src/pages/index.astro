---
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import Menu from '../components/Menu.astro';
import Resumen from '../components/secciones/Resumen.astro';
import Bases from '../components/secciones/Bases.astro';
import Calendario from '../components/secciones/Calendario.astro';
import Masteres from '../components/secciones/Masteres.astro';
import Preguntas from '../components/secciones/Preguntas.astro';
import Contacto from '../components/secciones/Contacto.astro';
import PreinscripcionModal from '../components/PreinscripcionModal.astro';
---

<Layout 
  title="Becas MásterCyL 2026-2027 · Fundación General Universidad de Salamanca | FGUSAL"
  description="Convocatoria de 2 becas de 8.800 € para cursar estudios oficiales de máster presenciales en la Universidad de Salamanca dirigidas a oriundos de Castilla y León residentes en Hispanoamérica."
>
  <main id="contenido" class="contenido">
    <article class="convocatoria">
      <!-- Banner superior de la convocatoria -->
      <Banner />

      <!-- Menú de navegación por pestañas -->
      <Menu />

      <!-- Contenedor dinámico de secciones -->
      <div class="secciones">
        <Resumen />
        <Bases />
        <Calendario />
        <Masteres />
        <Preguntas />
        <Contacto />
      </div>
    </article>
  </main>

  <!-- Modal interactivo de Preinscripción y Consulta de Estado -->
  <PreinscripcionModal />

  <!-- Lógica JavaScript Vanilla: Gestión de Pestañas, Buscador y Conexión con Backend (API/DB) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      /* ========================================================
         1. NAVEGACIÓN POR PESTAÑAS (TABS)
         ======================================================== */
      const menuLinks = document.querySelectorAll('.menu-secciones a');
      const secciones = document.querySelectorAll('.secciones .seccion');

      function activarSeccion(targetId, updateUrl = true) {
        if (!targetId) return;
        const idLimpio = targetId.replace('#', '');
        const targetSection = document.getElementById(idLimpio);

        if (!targetSection) return;

        // Quitar aria-current del enlace anterior y asignarlo al nuevo
        menuLinks.forEach((link) => {
          const href = link.getAttribute('href');
          if (href === `#${idLimpio}`) {
            link.setAttribute('aria-current', 'true');
          } else {
            link.removeAttribute('aria-current');
          }
        });

        // Ocultar todas las secciones y mostrar únicamente la seleccionada
        secciones.forEach((sec) => {
          sec.setAttribute('hidden', '');
        });
        targetSection.removeAttribute('hidden');

        // Actualizar URL hash si se solicita
        if (updateUrl && window.location.hash !== `#${idLimpio}`) {
          history.pushState(null, '', `#${idLimpio}`);
        }
      }

      // Manejar clics en los enlaces del menú de pestañas
      menuLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const targetHref = link.getAttribute('href');
          activarSeccion(targetHref, true);

          // Scroll suave hacia la sección si está fuera de pantalla
          const navElement = document.querySelector('.menu-secciones');
          if (navElement) {
            const rect = navElement.getBoundingClientRect();
            if (rect.top < 0 || rect.top > 150) {
              navElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        });
      });

      // Manejar enlaces internos en la página (footer, avisos, etc.)
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        if (!anchor.closest('.menu-secciones') && anchor.id !== 'btn-preinscripcion') {
          anchor.addEventListener('click', (e) => {
            const href = anchor.getAttribute('href');
            if (href && href !== '#' && document.querySelector(`.secciones ${href}`)) {
              e.preventDefault();
              activarSeccion(href, true);
              const target = document.querySelector(href);
              if (target) {
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }
          });
        }
      });

      // Leer el hash de la URL al cargar la página
      if (window.location.hash) {
        activarSeccion(window.location.hash, false);
      }

      // Reaccionar a cambios en el historial (botón atrás/adelante)
      window.addEventListener('hashchange', () => {
        if (window.location.hash) {
          activarSeccion(window.location.hash, false);
        }
      });

      /* ========================================================
         2. BUSCADOR Y FILTROS DE MÁSTERES EN TIEMPO REAL
         ======================================================== */
      const buscadorInput = document.getElementById('buscador-masteres');
      const btnLimpiar = document.getElementById('btn-limpiar-busqueda');
      const botonesFiltro = document.querySelectorAll('.btn-filtro');
      const masterCards = document.querySelectorAll('.master-card');
      const contador = document.getElementById('contador-masteres');
      const sinResultados = document.getElementById('sin-resultados');
      const btnResetear = document.getElementById('btn-resetear-filtros');

      let areaActiva = 'todas';
      let terminoBusqueda = '';

      function normalizar(texto) {
        return (texto || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .trim();
      }

      function filtrarMasteres() {
        const query = normalizar(terminoBusqueda);
        let visibles = 0;

        masterCards.forEach((card) => {
          const cardArea = card.getAttribute('data-area');
          const cardTitulo = normalizar(card.getAttribute('data-titulo'));
          const cardDesc = normalizar(card.getAttribute('data-desc'));
          const cardCentro = normalizar(card.getAttribute('data-centro'));

          const coincideArea = (areaActiva === 'todas' || cardArea === areaActiva);
          const coincideBusqueda = !query || 
            cardTitulo.includes(query) || 
            cardDesc.includes(query) || 
            cardCentro.includes(query);

          if (coincideArea && coincideBusqueda) {
            card.style.display = 'flex';
            visibles++;
          } else {
            card.style.display = 'none';
          }
        });

        if (contador) {
          contador.textContent = `Mostrando ${visibles} ${visibles === 1 ? 'máster oficial' : 'másteres oficiales'}`;
        }

        if (sinResultados) {
          sinResultados.style.display = visibles === 0 ? 'flex' : 'none';
        }

        if (btnLimpiar) {
          btnLimpiar.style.display = terminoBusqueda.length > 0 ? 'flex' : 'none';
        }
      }

      if (buscadorInput) {
        buscadorInput.addEventListener('input', (e) => {
          terminoBusqueda = e.target.value;
          filtrarMasteres();
        });
      }

      if (btnLimpiar) {
        btnLimpiar.addEventListener('click', () => {
          if (buscadorInput) {
            buscadorInput.value = '';
            terminoBusqueda = '';
            buscadorInput.focus();
            filtrarMasteres();
          }
        });
      }

      botonesFiltro.forEach((btn) => {
        btn.addEventListener('click', () => {
          botonesFiltro.forEach((b) => b.classList.remove('activo'));
          btn.classList.add('activo');
          areaActiva = btn.getAttribute('data-area') || 'todas';
          filtrarMasteres();
        });
      });

      if (btnResetear) {
        btnResetear.addEventListener('click', () => {
          if (buscadorInput) buscadorInput.value = '';
          terminoBusqueda = '';
          areaActiva = 'todas';
          botonesFiltro.forEach((b) => {
            if (b.getAttribute('data-area') === 'todas') b.classList.add('activo');
            else b.classList.remove('activo');
          });
          filtrarMasteres();
        });
      }

      /* ========================================================
         3. MODAL DE SOLICITUD DE BECA
         ======================================================== */
      const modal = document.getElementById('modal-preinscripcion');
      const btnPreinscripcion = document.getElementById('btn-preinscripcion');
      const btnCerrarModal = document.getElementById('btn-cerrar-modal');

      function abrirModal() {
        if (!modal) return;
        modal.showModal();
      }

      btnPreinscripcion?.addEventListener('click', (e) => {
        e.preventDefault();
        abrirModal();
      });

      btnCerrarModal?.addEventListener('click', () => {
        modal?.close();
      });

      modal?.addEventListener('click', (e) => {
        const rect = modal.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          modal.close();
        }
      });

      /* ========================================================
         4. ENVÍO DEL FORMULARIO OFICIAL DE SOLICITUD (API / DB)
         ======================================================== */
      const formPreinscripcion = document.getElementById('form-preinscripcion');
      const resultadoPre = document.getElementById('resultado-preinscripcion');
      const btnSubmitPre = document.getElementById('btn-submit-preinscripcion');
      const btnAddFamiliar = document.getElementById('btn-add-familiar');
      const tbodyFamiliar = document.getElementById('tbody-familiar');
      let famIdx = 1;

      // Añadir miembros a la tabla de ingresos familiares
      btnAddFamiliar?.addEventListener('click', () => {
        if (!tbodyFamiliar) return;
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>
            <select name="fam_relacion_${famIdx}" class="select-tabla">
              <option value="Padre">Padre</option>
              <option value="Madre">Madre</option>
              <option value="Tutor/a">Tutor/a</option>
              <option value="Cónyuge">Cónyuge</option>
              <option value="Hijo/a">Hijo/a</option>
              <option value="Hermano/a">Hermano/a</option>
              <option value="Otro">Otro familiar</option>
            </select>
          </td>
          <td><input type="text" name="fam_apellidos_${famIdx}" class="input-tabla" placeholder="Apellidos" required /></td>
          <td><input type="text" name="fam_nombre_${famIdx}" class="input-tabla" placeholder="Nombre" required /></td>
          <td><input type="text" name="fam_dni_${famIdx}" class="input-tabla" placeholder="DNI/Pasaporte" required /></td>
          <td>
            <select name="fam_percibido_${famIdx}" class="select-tabla">
              <option value="SI">SÍ</option>
              <option value="NO">NO</option>
            </select>
          </td>
          <td>
            <div style="display: flex; gap: 0.25rem; align-items: center;">
              <input type="text" name="fam_ingresos_${famIdx}" class="input-tabla" placeholder="Importe" />
              <button type="button" class="btn-del-fam" style="background: none; border: none; color: #dc2626; cursor: pointer; font-size: 1rem; font-weight: bold; padding: 0 4px;" title="Eliminar fila">✕</button>
            </div>
          </td>
        `;
        tbodyFamiliar.appendChild(tr);
        tr.querySelector('.btn-del-fam')?.addEventListener('click', () => tr.remove());
        famIdx++;
      });

      function imprimirModeloOficial(datos, codigo) {
        const w = window.open('', '_blank');
        if (!w) {
          alert('Por favor, autoriza las ventanas emergentes en tu navegador para ver e imprimir el impreso oficial.');
          return;
        }

        const famFilasHtml = (datos.familiares || []).map((f) => `
          <tr>
            <td style="padding: 6px; border: 1px solid #000; font-weight: bold;">${f.relacion || 'Familiar'}</td>
            <td style="padding: 6px; border: 1px solid #000;">${f.apellidos || ''}</td>
            <td style="padding: 6px; border: 1px solid #000;">${f.nombre || ''}</td>
            <td style="padding: 6px; border: 1px solid #000; font-family: monospace;">${f.dni || ''}</td>
            <td style="padding: 6px; border: 1px solid #000; text-align: center;">${f.percibe === 'SI' ? 'SI [X]  NO [ ]' : 'SI [ ]  NO [X]'}</td>
            <td style="padding: 6px; border: 1px solid #000;">${f.ingresos || '0'}</td>
          </tr>
        `).join('');

        const html = `
<!DOCTYPE html>
<html lang="es">
<head>
