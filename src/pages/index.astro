      <td>Consultable en la sede y página web oficial de la Fundación General (fundacion.usal.es).</td>
    </tr>
  </table>
</body>
</html>
        `;

        w.document.open();
        w.document.write(html);
        w.document.close();
      }

      if (formPreinscripcion) {
        formPreinscripcion.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!btnSubmitPre) return;

          const formData = new FormData(formPreinscripcion);

          // Extraer miembros de la tabla de ingresos familiares
          const familiares = [];
          const trs = tbodyFamiliar?.querySelectorAll('tr') || [];
          trs.forEach((tr) => {
            const relacion = tr.querySelector('strong')?.innerText || tr.querySelector('select')?.value || 'Solicitante';
            const inputs = tr.querySelectorAll('input');
            const selects = tr.querySelectorAll('select');
            const apellidos = inputs[0]?.value || '';
            const nombre = inputs[1]?.value || '';
            const dni = inputs[2]?.value || '';
            const percibe = selects.length > 0 ? selects[selects.length - 1].value : 'NO';
            const ingresos = inputs[3]?.value || inputs[inputs.length - 1]?.value || '0';
            if (apellidos || nombre || dni) {
              familiares.push({ relacion, apellidos, nombre, dni, percibe, ingresos });
            }
          });

          const payload = {
            nombre: formData.get('nombre'),
            apellidos: formData.get('apellidos'),
            dniPasaporte: formData.get('dniPasaporte'),
            email: formData.get('email'),
            telefono: formData.get('telefono'),
            vinculoCyl: formData.get('vinculoCyl'),
            direccionHispanoamerica: formData.get('direccionHispanoamerica'),
            direccionCyl: formData.get('direccionCyl'),
            titulacionAcceso: formData.get('titulacionAcceso'),
            masterInteres: formData.get('masterInteres'),
            masterOpcion2: formData.get('masterOpcion2'),
            masterOpcion3: formData.get('masterOpcion3'),
            cuentaBancaria: formData.get('cuentaBancaria'),
            composicionFamiliar: formData.get('composicion_familiar'),
            lugarFirma: formData.get('lugarFirma'),
            politicaPrivacidad: document.getElementById('pre-check-privacidad')?.checked || false,
            familiares
          };

          btnSubmitPre.disabled = true;
          btnSubmitPre.style.opacity = '0.7';
          btnSubmitPre.innerHTML = '<span>Procesando y registrando solicitud oficial...</span>';
          if (resultadoPre) resultadoPre.style.display = 'none';

          try {
            const resp = await fetch('/api/preinscripcion', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            const data = await resp.json();

            if (resultadoPre) {
              resultadoPre.style.display = 'block';
              if (data.success) {
                resultadoPre.className = 'resultado-caja resultado-caja--exito';
                resultadoPre.innerHTML = `
                  <div style="font-size: 1.1rem; font-weight: 800; color: #166534; margin-bottom: 0.5rem;">
                    ✓ Solicitud Oficial Registrada con Éxito
                  </div>
                  <div style="padding: 1rem; background: rgba(255,255,255,0.85); border-radius: 8px; border: 1px solid #86EFAC;">
                    <div><strong>Código Oficial de Registro:</strong> <span style="font-family: monospace; font-size: 1.2rem; color: #9E1B32; font-weight: 800;">${data.codigo}</span></div>
                    <div style="margin-top: 0.25rem;"><strong>Solicitante:</strong> ${payload.nombre} ${payload.apellidos}</div>
                    <div style="margin-top: 0.25rem;"><strong>Máster (1.ª Opción Presencial):</strong> ${payload.masterInteres}</div>
                    <div style="margin-top: 0.25rem;"><strong>Estado:</strong> <span style="color: #166534; font-weight: 700;">Preinscrito</span></div>
                    <div style="font-size: 0.85rem; color: #475569; margin-top: 0.5rem; line-height: 1.45;">
                      Tu solicitud ha quedado guardada en la base de datos de la Fundación General (FGUSAL) y se ha enviado la notificación por correo a la Comisión de Selección.
                    </div>
                  </div>
                  <div style="margin-top: 1.25rem; text-align: center;">
                    <button type="button" id="btn-generar-impreso" class="btn-imprimir-pdf">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                      <span>Descargar / Imprimir Solicitud Oficial Cumplimentada (PDF)</span>
                    </button>
                  </div>
                `;

                document.getElementById('btn-generar-impreso')?.addEventListener('click', () => {
                  imprimirModeloOficial(payload, data.codigo);
                });
              } else {
                resultadoPre.className = 'resultado-caja resultado-caja--error';
                resultadoPre.innerHTML = `<strong>✕ Error:</strong> ${data.error || 'No se pudo guardar la solicitud.'}`;
              }
            }
          } catch (err) {
            if (resultadoPre) {
              resultadoPre.style.display = 'block';
              resultadoPre.className = 'resultado-caja resultado-caja--error';
              resultadoPre.innerHTML = '<strong>✕ Error de conexión:</strong> No se pudo conectar con el servidor. Inténtalo de nuevo.';
            }
          } finally {
            btnSubmitPre.disabled = false;
            btnSubmitPre.style.opacity = '1';
            btnSubmitPre.innerHTML = `
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
              <span>Presentar Solicitud Telemática Oficial</span>
            `;
          }
        });
      }

      /* ========================================================
         5. ENVÍO DEL FORMULARIO DE CONTACTO (API / DB)
         ======================================================== */
      const formContacto = document.getElementById('formulario-contacto');
      const mensajeExito = document.getElementById('mensaje-exito');
      const mensajeError = document.getElementById('mensaje-error');

      if (formContacto) {
        formContacto.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = formContacto.querySelector('button[type="submit"]');

          const payload = {
            nombre: document.getElementById('nombre-contacto')?.value,
            email: document.getElementById('email-contacto')?.value,
            pais: document.getElementById('pais-contacto')?.value,
            asunto: document.getElementById('asunto-contacto')?.value,
            mensaje: document.getElementById('mensaje-contacto')?.value,
          };

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.7';
            submitBtn.innerHTML = '<span>Enviando al servidor...</span>';
          }
          if (mensajeExito) mensajeExito.style.display = 'none';
          if (mensajeError) mensajeError.style.display = 'none';

          try {
            const resp = await fetch('/api/contacto', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            const data = await resp.json();

            if (data.success) {
              if (mensajeExito) {
                mensajeExito.style.display = 'block';
                mensajeExito.textContent = `✓ ¡Gracias! Tu consulta (ID #${data.id}) ha sido guardada en la base de datos de FGUSAL. Te responderemos en un plazo máximo de 24-48 horas.`;
              }
              formContacto.reset();
            } else {
              if (mensajeError) {
                mensajeError.style.display = 'block';
                mensajeError.textContent = `✕ Error: ${data.error || 'No se pudo enviar la consulta.'}`;
              }
            }
          } catch (err) {
            if (mensajeError) {
              mensajeError.style.display = 'block';
              mensajeError.textContent = '✕ Error de conexión con el servidor.';
            }
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.style.opacity = '1';
              submitBtn.innerHTML = `
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                <span>Enviar consulta a FGUSAL</span>
              `;
            }
          }
        });
      }
    });
  </script>
</Layout>
